{
  "name": "zuckerhaltig",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:data && next build",
    "start": "next start",
    "typecheck": "npm run validate:data && tsc --noEmit",
    "validate:data": "node scripts/validate-drinks-data.mjs",
    "social:generate": "tsx scripts/social-generate.ts",
    "social:upload-r2": "tsx scripts/social-upload-r2.ts",
    "social:buffer": "tsx scripts/social-buffer.ts",
    "social:channels": "tsx scripts/social-buffer.ts --list-channels",
    "social:preview": "tsx scripts/social-generate.ts --date preview --count 5 --allow-repeats",
    "social:check": "tsx scripts/social-generate.ts --date check --count 5 --dry-run"
  },
  "dependencies": {
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "4.8.1",
    "typescript": "^5.7.2"
  }
}
